{
  "name": "api",
  "type": "server",
  "description": "Primary Express API runtime.",
  "internalDependencies": ["eslint-config", "logging", "tsconfig", "types"],
  "externalDependencies": ["@better-auth/mongo-adapter", "@socket.io/mongo-adapter", "@opentelemetry/api", "@opentelemetry/core", "@opentelemetry/exporter-metrics-otlp-http", "@opentelemetry/resources", "@opentelemetry/sdk-metrics", "better-auth", "cloudinary", "dotenv", "express", "mongodb", "mongoose", "multer", "socket.io", "zod"],
  "capabilities": ["http-api", "health", "google-sso", "workspace-access", "channels", "direct-messages", "message-search", "notifications", "chat-attachments", "mongodb-integration", "socket-io-realtime", "otlp-metrics"],
  "tasks": {
    "dev": { "command": "pnpm run dev", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "CLOUDINARY_CLOUD_NAME", "CLOUDINARY_API_KEY", "CLOUDINARY_API_SECRET", "OTEL_EXPORTER_OTLP_ENDPOINT", "OTEL_EXPORTER_OTLP_HEADERS", "OTEL_SERVICE_NAME"], "cache": false },
    "channels:initialize": { "command": "pnpm run channels:initialize", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"], "cache": false },
    "direct-messages:initialize": { "command": "pnpm run direct-messages:initialize", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"], "cache": false },
    "notifications:initialize": { "command": "pnpm run notifications:initialize", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"], "cache": false },
    "workspaces:initialize": { "command": "pnpm run workspaces:initialize", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"], "cache": false },
    "build:vercel": { "command": "pnpm run build:vercel", "outputs": ["vercel/server.mjs"], "cache": false },
    "build": { "command": "pnpm run build", "outputs": ["dist"], "cache": true },
    "test": { "command": "pnpm test", "cache": false },
    "lint": { "command": "pnpm run lint", "cache": false },
    "typecheck": { "command": "pnpm run typecheck", "cache": false }
  }
}
