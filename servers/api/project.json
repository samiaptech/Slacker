{
  "name": "api",
  "type": "server",
  "description": "Primary Express API runtime.",
  "internalDependencies": ["eslint-config", "logging", "tsconfig", "types"],
  "externalDependencies": ["@better-auth/mongo-adapter", "better-auth", "dotenv", "express", "mongoose", "socket.io", "zod"],
  "capabilities": ["http-api", "health", "google-sso", "workspace-access", "channels", "direct-messages", "mongodb-integration", "socket-io-realtime"],
  "tasks": {
    "dev": { "command": "pnpm run dev", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"], "cache": false },
    "channels:initialize": { "command": "pnpm run channels:initialize", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"], "cache": false },
    "direct-messages:initialize": { "command": "pnpm run direct-messages:initialize", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"], "cache": false },
    "workspaces:initialize": { "command": "pnpm run workspaces:initialize", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"], "cache": false },
    "build": { "command": "pnpm run build", "outputs": ["dist"], "cache": true },
    "test": { "command": "pnpm test", "cache": false },
    "lint": { "command": "pnpm run lint", "cache": false },
    "typecheck": { "command": "pnpm run typecheck", "cache": false }
  }
}
