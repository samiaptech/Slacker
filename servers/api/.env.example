NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
MONGODB_URI=mongodb://127.0.0.1:27017/workspace
BETTER_AUTH_URL=http://localhost:4000
# Generate a random secret of at least 32 characters for local development and production.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# Optional chat attachments. Set all three values to enable private Cloudinary storage.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Register `${BETTER_AUTH_URL}/api/auth/callback/google` as an authorized redirect URI in Google Cloud.
# LAN access: set API_HOST=0.0.0.0, WEB_ORIGIN to the web URL on this computer's LAN IP,
# and BETTER_AUTH_URL to that same IP on API_PORT. Set the web app's
# NEXT_PUBLIC_API_BASE_URL to the LAN IP on API_PORT. Do not use the web port for API calls.
# Initialize workspace collections once per MongoDB database:
# pnpm --filter @workspace/api workspaces:initialize
